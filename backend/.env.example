# Copy this file to .env and fill in real values. .env is gitignored.
# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key-here
# Shared API key the frontend sends as the X-API-Key header
API_KEY=dev-secret-key-12345

# --- Live cruise search (Tavily, https://app.tavily.com — free tier available) ---
# Without this the inventory agent tells guests live search is unavailable.
TAVILY_API_KEY=your-tavily-api-key-here
# Optional tuning (sensible defaults are built in):
#   CRUISE_SEARCH_EXCLUDE_DOMAINS  comma list of sites to drop from live search (default: OTAs/discount sellers)
#   CRUISE_SEARCH_INCLUDE_DOMAINS  comma list to restrict live search to specific sites
#   OUTBOUND_LINK_ALLOWLIST        hosts the chatbot may link to (default: horizonvoyages.net,calendly.com).
#                                  Every other URL/domain is stripped from chat replies so guests can't
#                                  book around the advisor. Add a Fora-attributed Partner Booking Link host here.

# --- Booking-lead email (Gmail SMTP) ---
# Generate a 16-char App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
SMTP_USER=youraddress@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
LEAD_NOTIFICATION_EMAIL=juanventure@gmail.com

# --- Infrastructure ---
DATABASE_URL=postgresql://user:password@localhost:5432/travel_db
REDIS_URL=redis://localhost:6379/0

# --- Security / abuse controls ---
# Comma-separated browser origins allowed by CORS. Use your real domain in prod.
ALLOWED_ORIGINS=http://localhost
# Per-IP rate limits (requests per minute)
CHAT_RATE_LIMIT_PER_MINUTE=20
BOOKING_RATE_LIMIT_PER_MINUTE=10
CONSULTATION_RATE_LIMIT_PER_MINUTE=5
# Cloudflare Turnstile bot protection (https://dash.cloudflare.com/?to=/:account/turnstile)
# Get a widget at the dashboard; put the SECRET key here and the SITE key in the
# frontend (script.js TURNSTILE_SITE_KEY). Leave empty to disable.
# Test keys: secret 1x0000000000000000000000000000000AA always passes,
#            2x0000000000000000000000000000000AA always fails.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin dashboard (HTTP Basic auth) served at /admin — lists captured leads and
# consultation inquiries. Leave either blank to disable the page entirely.
# Use a strong password and serve over HTTPS in production.
# Advisor Portal (admin.html) passkey, checked SERVER-SIDE. If unset, ADMIN_PASSWORD
# is used. If neither is set, the portal/itinerary admin API refuses everyone.
# Choose a long random value; never commit it or put it in any HTML/JS file.
ADVISOR_PASSKEY=change-me-to-a-long-random-passkey
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
