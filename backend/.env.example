# Copy this file to .env and fill in real values. .env is gitignored.
# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key-here
# Shared API key the frontend sends as the X-API-Key header
API_KEY=dev-secret-key-12345

# --- Booking-lead email (Gmail SMTP) ---
# Generate a 16-char App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
SMTP_USER=youraddress@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
LEAD_NOTIFICATION_EMAIL=juanventure@gmail.com

# --- Infrastructure ---
DATABASE_URL=postgresql://user:password@localhost:5432/travel_db
REDIS_URL=redis://localhost:6379/0

# --- Security / abuse controls ---
# Comma-separated browser origins allowed by CORS. Use your real domain in prod.
ALLOWED_ORIGINS=http://localhost
# Per-IP rate limits (requests per minute)
CHAT_RATE_LIMIT_PER_MINUTE=20
BOOKING_RATE_LIMIT_PER_MINUTE=10
CONSULTATION_RATE_LIMIT_PER_MINUTE=5
# Cloudflare Turnstile bot protection (https://dash.cloudflare.com/?to=/:account/turnstile)
# Get a widget at the dashboard; put the SECRET key here and the SITE key in the
# frontend (script.js TURNSTILE_SITE_KEY). Leave empty to disable.
# Test keys: secret 1x0000000000000000000000000000000AA always passes,
#            2x0000000000000000000000000000000AA always fails.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin dashboard (HTTP Basic auth) served at /admin — lists captured leads and
# consultation inquiries. Leave either blank to disable the page entirely.
# Use a strong password and serve over HTTPS in production.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
